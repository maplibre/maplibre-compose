---
// The bar that stays in view while scrolling a dashboard. The first row says what
// the page measures, in the default slot, and which part of the history the
// charts show and how they space it. The second row names the selected commit and
// steps through the history. The dashboard's CommitSelection drives everything
// but the slot, and shows the range and the commit once it has data.
---

<div class="metrics-bar">
  <div class="metrics-bar-row">
    <slot />
    <div id="metrics-range" class="metrics-range" hidden>
      <span id="metrics-range-status" class="metrics-muted"></span>
      <button id="metrics-range-reset" class="metrics-link-button" hidden>
        Show all
      </button>
      <div
        class="metrics-segmented"
        role="radiogroup"
        aria-label="Space commits"
      >
        <button role="radio" data-spacing="commits">By commit</button>
        <button role="radio" data-spacing="dates">By date</button>
      </div>
    </div>
  </div>
  <div id="metrics-commit" class="metrics-commit" hidden>
    <div class="metrics-nav" role="group" aria-label="Commits">
      <button id="metrics-previous-release"></button>
      <button id="metrics-previous"></button>
      <button id="metrics-next"></button>
      <button id="metrics-next-release"></button>
    </div>
    <span id="metrics-selection-label"></span>
    <span id="metrics-selection-commit"></span>
    <span id="metrics-selection-title" class="metrics-muted"></span>
  </div>
</div>
