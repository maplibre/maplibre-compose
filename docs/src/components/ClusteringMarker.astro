---
interface Props {
  count?: number;
  visible: boolean;
  transform: string;
  frames?: Keyframe[];
  visibility?: Keyframe[];
}
const { count, visible, transform, frames, visibility } = Astro.props;
---

<g opacity={visible ? 1 : 0} data-camera-frames={JSON.stringify(visibility)}>
  <g
    style={`transform: ${transform}`}
    data-camera-frames={JSON.stringify(frames)}
  >
    <circle class:list={["marker", { point: !count }]} r={count ? 14 : 4} />
    <text
      y="0.5"
      text-anchor="middle"
      dominant-baseline="middle"
      display={count ? undefined : "none"}
    >
      {count}
    </text>
  </g>
</g>

<style>
.marker {
  fill: var(--cluster-color);
}

.point {
  stroke: #fff;
  stroke-width: 1;
}

text {
  fill: var(--count-color);
  font-family: var(--sl-font);
  font-size: 12px;
  font-weight: 600;
}
</style>
