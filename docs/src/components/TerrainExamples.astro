---
import { Image } from "astro:assets";

import buildings from "../assets/terrain/buildings.webp";
import hillshade from "../assets/terrain/hillshade.webp";
import relief from "../assets/terrain/relief.webp";

interface Props {
  effect: "buildings" | "hillshade" | "relief";
}

// Captured with the pinned MapLibre GL JS build and the Terrain.kt layer values.
const examples = {
  buildings: {
    image: buildings,
    alt: "Gray buildings rise above streets in Lower Manhattan, with labels drawn over the buildings.",
    caption: "3D buildings in Lower Manhattan",
  },
  hillshade: {
    image: hillshade,
    alt: "Shadows and highlights show mountain ridges and valleys around Innsbruck on a flat map.",
    caption: "Hillshade around Innsbruck",
  },
  relief: {
    image: relief,
    alt: "Elevation colors around Innsbruck change from green in the valleys to yellow and brown on higher mountains.",
    caption: "Color relief around Innsbruck",
  },
};
const { effect } = Astro.props;
const example = examples[effect];
---

<figure class="not-content">
  <Image
    src={example.image}
    alt={example.alt}
    widths={[640, 1280]}
    sizes="(max-width: 640px) 100vw, 640px"
  />
  <figcaption>
    {example.caption}
  </figcaption>
</figure>

<style>
figure {
  max-width: 40rem;
  margin: 1.5rem auto;
}

img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--sl-color-gray-5);
  border-radius: 0.375rem;
}

figcaption {
  margin-top: 0.5rem;
  color: var(--sl-color-gray-2);
  font-size: 0.875rem;
  text-align: center;
}
</style>
