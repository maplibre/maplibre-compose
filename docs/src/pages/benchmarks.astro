---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CommitSelection from "../components/CommitSelection.astro";
import "../styles/metrics.css";
import "../styles/benchmarks.css";

// Set by mise to the published data, or to a local copy by `mise run metrics:dev`.
const source =
  process.env.METRICS_DATA_URL ??
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/metrics-data/`;
---

<StarlightPage
  frontmatter={{
    title: "Benchmarks",
    description:
      "Map performance of MapLibre Compose per device and commit on main, beside the classic SDKs.",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <div class="metrics benchmarks" data-source={`${source}benchmarks/`}>
    <!-- The device and the commit stay in reach while scrolling the charts. -->
    <CommitSelection>
      <label>
        <span class="sr-only">Device</span>
        <select id="benchmarks-scope"></select>
      </label>
      <span
        slot="trailing"
        id="benchmarks-scope-note"
        class="metrics-muted"
      ></span>
    </CommitSelection>

    <p id="metrics-status" class="metrics-status" role="status">Loading…</p>

    <div id="metrics-body" hidden>
      <div id="metrics-tiles" class="metrics-tiles"></div>

      <div id="metrics-charts"></div>
    </div>
  </div>

  <script>
  import { start } from "../benchmarks/dashboard";
    start();
  </script>
</StarlightPage>
