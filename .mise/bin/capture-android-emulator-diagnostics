#!/usr/bin/env bash
# Captures bounded diagnostics from the Android emulator after a device-test failure.
set -u

project_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
state_dir="$project_root/build/android-emulator"
# Optional first argument names a subdirectory so a retry can keep the first hang.
if [[ -n "${1:-}" ]]; then
  diagnostics_dir="$state_dir/diagnostics/$1"
else
  diagnostics_dir="$state_dir/diagnostics"
fi
sdk_root="$("$(dirname "${BASH_SOURCE[0]}")/android-sdk-root")"
adb="$sdk_root/platform-tools/adb"

mkdir -p "$diagnostics_dir"
serial=${ANDROID_SERIAL:-$(cat "$state_dir/serial" 2>/dev/null)}
devices-cli ls --json >"$diagnostics_dir/devices.json" 2>&1 || true
cli_logs="${XDG_STATE_HOME:-$HOME/.local/state}/devices-cli/logs"
if [[ -n "$serial" && -f "$cli_logs/$serial.log" ]]; then
  cp "$cli_logs/$serial.log" "$diagnostics_dir/emulator.log"
fi
[[ -n "$serial" ]] || { echo "No selected Android serial recorded." >"$diagnostics_dir/no-device.txt"; exit 0; }

capture() {
  local name=$1
  local timeout_seconds=$2
  shift 2
  local output="$diagnostics_dir/$name.txt"
  local command_pid waited=0 status=0

  {
    printf 'Command:'
    printf ' %q' "$@"
    printf '\n\n'
  } >"$output"

  "$@" >>"$output" 2>&1 &
  command_pid=$!
  while ((waited < timeout_seconds)) && kill -0 "$command_pid" 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$command_pid" 2>/dev/null; then
    printf '\nCommand timed out after %d seconds.\n' "$timeout_seconds" >>"$output"
    kill -KILL "$command_pid" 2>/dev/null || true
  fi
  wait "$command_pid" || status=$?
  printf '\nExit status: %d\n' "$status" >>"$output"
}

capture host-date 10 date -u
capture host-kernel 10 uname -a
capture host-disk 10 df -h
capture host-memory 10 free -h
capture host-processes 10 ps -eo pid,ppid,state,etime,%cpu,%mem,rss,vsz,comm

if [[ ! -x "$adb" ]]; then
  printf 'adb is unavailable at %s.\n' "$adb" >"$diagnostics_dir/adb-unavailable.txt"
  exit 0
fi

capture adb-devices 15 "$adb" devices -l
capture emulator-state 15 "$adb" -s "$serial" get-state
capture emulator-properties 30 "$adb" -s "$serial" shell getprop
capture emulator-disk 30 "$adb" -s "$serial" shell df -h
capture emulator-diskstats 30 "$adb" -s "$serial" shell dumpsys diskstats
capture emulator-memory 30 "$adb" -s "$serial" shell cat /proc/meminfo
capture emulator-processes 30 "$adb" -s "$serial" shell ps
capture emulator-package-manager 60 "$adb" -s "$serial" shell dumpsys package
capture emulator-kernel 30 "$adb" -s "$serial" shell dmesg
capture emulator-logcat 60 "$adb" -s "$serial" logcat -b all -d -v threadtime
