#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$repo_root"
.mise/bin/sync-maplibre-gl-js
source_path="$repo_root/third_party/maplibre-gl-js"
output="$repo_root/lib/maplibre-compose/build/maplibre-gl-js"

# Keep native Node tooling in step with its lockfile and host architecture.
install_state="$(cat "$source_path/package-lock.json" | git hash-object --stdin) $(node -p 'process.version + " " + process.platform + " " + process.arch')"
install_stamp="$source_path/node_modules/.maplibre-compose-install"
if [[ ! -f "$install_stamp" || "$(cat "$install_stamp")" != "$install_state" ]]; then
  (cd "$source_path" && npm ci --ignore-scripts --no-audit --no-fund)
  printf '%s\n' "$install_state" > "$install_stamp"
fi

state="$(
  git -C "$source_path" rev-parse HEAD
  git -C "$source_path" diff --binary HEAD
  cat "$repo_root/tools/maplibre-gl-js/build.mjs" "$repo_root/tools/maplibre-gl-js/runtime.mjs" \
    "$repo_root/.mise/bin/build-maplibre-gl-js" "$repo_root/gradle/libs.versions.toml"
  printf '%s\n' "$install_state"
)"
state="$(printf '%s' "$state" | git hash-object --stdin)"
if [[ -f "$output/.stamp" && "$(cat "$output/.stamp")" == "$state" && -f "$output/worker.mjs" && -f "$output/index.mjs" ]]; then
  exit 0
fi

(cd "$source_path" && npm run codegen && npm run build-prod)
node tools/maplibre-gl-js/build.mjs
printf '%s\n' "$state" > "$output/.stamp"
