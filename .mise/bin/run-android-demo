#!/usr/bin/env bash
# Build the demo app, install it, and launch it on a connected Android device
# or emulator. Prompts when several devices are connected.
set -euo pipefail

repository_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
adb="$("$repository_root/.mise/bin/android-sdk-root")/platform-tools/adb"

# mise passes usage args as environment variables; the arguments are for
# running this script outside of mise.
requested="${1:-${usage_serial:-}}"

export ANDROID_HOME
ANDROID_HOME="$("$repository_root/.mise/bin/android-sdk-root")"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export ANDROID_SERIAL
if [[ -n "$requested" || -n "${ANDROID_SERIAL:-}" ]]; then
  ANDROID_SERIAL="$("$repository_root/.mise/bin/pick-android-device" "$requested")"
else
  args=("${usage_api_level:-36}")
  [[ "${usage_headful:-false}" != true ]] || args+=(--headful)
  case "${MAPLIBRE_DEMO_PROFILE:-phone}" in
    wear) args+=(--wear) ;;
    tv) args+=(--tv) ;;
  esac
  ANDROID_SERIAL="$("$repository_root/.mise/bin/boot-android-emulator" "${args[@]}")"
fi

mkdir -p "$repository_root/build/android-emulator"
printf '%s\n' "$ANDROID_SERIAL" >"$repository_root/build/android-emulator/serial"

# MAPLIBRE_DEMO_MODULE names the application module: android (default) or wearos.
case "${MAPLIBRE_DEMO_MODULE:-android}" in
  android) module=android application_id=org.maplibre.compose.demoapp ;;
  wearos) module=wearos application_id=org.maplibre.compose.demoapp.wear ;;
  *)
    echo "Unknown demo module: $MAPLIBRE_DEMO_MODULE" >&2
    exit 2
    ;;
esac

"$repository_root/gradlew" ":demo-app:$module:installDebug" \
  -Pmaplibre.android.backend="${usage_backend:-opengl}"
# The phone demo reads these extras; see AGENTS.md, "Driving the demo app".
extras=()
[ -n "${usage_route:-}" ] && extras+=(--es route "$usage_route")
[ -n "${usage_camera:-}" ] && extras+=(--es camera "$usage_camera")
"$adb" -s "$ANDROID_SERIAL" shell am start \
  -a android.intent.action.MAIN \
  -c android.intent.category.LAUNCHER \
  -n "$application_id/.MainActivity" ${extras[@]+"${extras[@]}"}
