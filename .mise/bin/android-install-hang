#!/usr/bin/env bash
# Exit 0 when a Gradle log describes an Android session-install hang.
set -euo pipefail

log=${1:?usage: android-install-hang <gradle-log>}

# The module whose APK install hung never reached the runner.
grep -q 'Starting 0 tests' "$log" || exit 1

# ddmlib gave up writing the session rather than reporting a JUnit failure.
if grep -qE 'ShellCommandUnresponsiveException|Failed to install-write all apks' "$log"; then
  exit 0
fi
exit 1
