#!/usr/bin/env bash
# Print this worktree's ready Android serial; progress goes to stderr.
set -euo pipefail

api_level=${1:?usage: boot-android-emulator <api-level> [--headful] [--wear | --tv]}
shift
headful=false
profile=
variant=default
for arg in "$@"; do
  case "$arg" in
    --headful) headful=true ;;
    --headless) headful=false ;;
    --wear | --tv)
      [[ -z "$profile" ]] || { echo "Choose only one of --wear and --tv." >&2; exit 2; }
      if [[ "$arg" == --wear ]]; then
        profile=wearos_small_round
        variant=android-wear
        if ((${api_level%%.*} >= 36)); then variant=android-wear-signed; fi
      else
        profile=tv_1080p
        variant=android-tv
      fi
      ;;
    *) echo "Unknown emulator option: $arg" >&2; exit 2 ;;
  esac
done
project_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export ANDROID_HOME
ANDROID_HOME="$("$project_root/.mise/bin/android-sdk-root")"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# A caller-selected device is never replaced or stopped by this helper.
if [[ -n "${ANDROID_SERIAL:-}" ]]; then
  exec "$project_root/.mise/bin/pick-android-device" "$ANDROID_SERIAL"
fi

# Older gfxstream revisions can hang when a guest exits with live GLES objects
# (b/561516389). This applies to the Native map tests on macOS and Linux alike.
minimum_emulator_version=37.3.5
revision=$(sed -n 's/^Pkg\.Revision=//p' "$ANDROID_HOME/emulator/source.properties" 2>/dev/null | tr -d '\r') || true
if [[ "$(printf '%s\n' "$minimum_emulator_version" "$revision" | sort -V | head -n1)" != "$minimum_emulator_version" ]]; then
  install=()
  for tool in android sdkmanager; do
    for candidate in "$ANDROID_HOME"/cmdline-tools/latest/bin/"$tool" "$ANDROID_HOME"/cmdline-tools/*/bin/"$tool"; do
      [[ -x "$candidate" ]] || continue
      if [[ "$tool" == android ]]; then
        install=("$candidate" --sdk="$ANDROID_HOME" sdk install --canary emulator)
      else
        install=("$candidate" --sdk_root="$ANDROID_HOME" --channel=2 --install emulator)
      fi
      break 2
    done
  done
  ((${#install[@]})) || { echo "Install Android emulator $minimum_emulator_version or later with SDK command-line tools." >&2; exit 1; }
  "${install[@]}" <<<"y" >&2
fi
args=(get android --owner "$project_root" --api "$api_level" --variant "$variant")
[[ -z "$profile" ]] || args+=(--device-profile "$profile")
gpu=swiftshader
if [[ "$headful" == true ]]; then args+=(--headful); gpu=host; fi
serial=$(devices-cli "${args[@]}" -- -gpu "$gpu" -camera-back none -camera-front none)
mkdir -p "$project_root/build/android-emulator"
printf '%s\n' "$serial" >"$project_root/build/android-emulator/serial"
printf '%s\n' "$serial"
