#!/usr/bin/env bash
# Print this worktree's iPhone simulator UDID; progress goes to stderr.
set -euo pipefail
project_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
args=(get ios --owner "$project_root")
[[ -z "${1:-}" ]] || args+=(--runtime "$1")
[[ -z "${usage_device_type:-}" ]] || args+=(--device-type "$usage_device_type")
udid=$(devices-cli "${args[@]}")
if [[ "${usage_headful:-false}" == true ]]; then
  open -a Simulator --args -CurrentDeviceUDID "$udid"
fi
printf '%s\n' "$udid"
