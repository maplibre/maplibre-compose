#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <file-path>" >&2
  exit 2
fi

repo_root="${MISE_MONOREPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# The workspace-wide pnpm install covers the docs site, and pnpm is a
# repository-wide tool, so mdxlint runs without a project-scoped tool hop.
cd "$repo_root/docs"
exec pnpm exec mdxlint --rc-path .mdxlintrc.json --file-path "$1"
