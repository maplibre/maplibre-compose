#!/usr/bin/env bash
# Run connected Android tests against a selected or worktree-owned device.
set -euo pipefail

api_level=${1:?usage: run-android-device-tests <api-level>}

project_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
owned=true
[[ -z "${ANDROID_SERIAL:-}" ]] || owned=false
export ANDROID_HOME
ANDROID_HOME="$("$project_root/.mise/bin/android-sdk-root")"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export ANDROID_SERIAL
ANDROID_SERIAL="$("$project_root/.mise/bin/boot-android-emulator" "$api_level")"
adb="$("$project_root/.mise/bin/android-sdk-root")/platform-tools/adb"
actual_api=$("$adb" -s "$ANDROID_SERIAL" shell getprop ro.build.version.sdk | tr -d '\r')
if [[ "$actual_api" != "$api_level" ]]; then
  echo "Android device $ANDROID_SERIAL runs API $actual_api; tests requested API $api_level." >&2
  exit 1
fi
mkdir -p "$project_root/build/android-emulator"
printf '%s\n' "$ANDROID_SERIAL" >"$project_root/build/android-emulator/serial"
log="$project_root/build/android-emulator/device-tests.log"

run_gradle() {
  "$project_root/gradlew" --no-parallel \
    connectedDebugAndroidTest \
    connectedAndroidDeviceTest
}

echo "Running Android device tests for API $api_level."

set +e
run_gradle 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
set -e

if ((status == 0)); then
  exit 0
fi

# Session install hung: ddmlib never wrote the APK, so the runner started 0 tests.
if ! grep -q 'Starting 0 tests' "$log" ||
  ! grep -qE 'ShellCommandUnresponsiveException|Failed to install-write all apks' "$log"; then
  exit "$status"
fi

echo "Android session install hung; capturing diagnostics before reboot."
"$project_root/.mise/bin/capture-android-emulator-diagnostics" attempt-1
[[ "$owned" == true ]] || exit "$status"
echo "Rebooting the emulator and retrying once."
"$project_root/.mise/bin/stop-android-emulator"
unset ANDROID_SERIAL
export ANDROID_SERIAL
ANDROID_SERIAL="$("$project_root/.mise/bin/boot-android-emulator" "$api_level")"

set +e
{
  printf '\n===== retry after session-install hang =====\n'
  run_gradle
} 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
set -e
exit "$status"
