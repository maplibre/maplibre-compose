#!/usr/bin/env bash
# Run connected Android tests against the mise-managed emulator.
set -euo pipefail

api_level=${1:?usage: run-android-device-tests <api-level>}

# Same selection as boot-android-emulator: the guest image this host can accelerate.
case "$(uname -m)" in
  arm64 | aarch64) abi=arm64-v8a ;;
  *) abi=x86_64 ;;
esac

project_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
mkdir -p "$project_root/build/android-emulator"
log="$project_root/build/android-emulator/device-tests.log"

run_gradle() {
  "$project_root/gradlew" --no-parallel \
    connectedDebugAndroidTest \
    connectedAndroidDeviceTest \
    -Pmaplibre.android.abis="$abi"
}

echo "Running Android device tests for API $api_level, packaging JNI ABI $abi."

set +e
run_gradle 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
set -e

if ((status == 0)); then
  exit 0
fi

# Session install hung: ddmlib never wrote the APK, so the runner started 0 tests.
if ! grep -q 'Starting 0 tests' "$log" ||
  ! grep -qE 'ShellCommandUnresponsiveException|Failed to install-write all apks' "$log"; then
  exit "$status"
fi

echo "Android session install hung; rebooting the emulator and retrying once."
"$project_root/.mise/bin/stop-android-emulator"
"$project_root/.mise/bin/boot-android-emulator" "$api_level" --headless

set +e
{
  printf '\n===== retry after session-install hang =====\n'
  run_gradle
} 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
set -e
exit "$status"
