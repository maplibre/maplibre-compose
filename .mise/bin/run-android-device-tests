#!/usr/bin/env bash
# Run connected Android tests against the mise-managed emulator.
# Packages only this host's JNI ABI, and retries once after a session-install hang.
set -euo pipefail

api_level=${1:?usage: run-android-device-tests <api-level>}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_root="${MISE_PROJECT_ROOT:-$(cd "$script_dir/../.." && pwd)}"
abi="$("$script_dir/android-host-abi")"
gradlew="${ANDROID_DEVICE_TEST_GRADLE:-$project_root/gradlew}"
state_dir="$project_root/build/android-emulator"
mkdir -p "$state_dir"
log="$state_dir/device-tests.log"

run_gradle() {
  "$gradlew" --no-parallel \
    connectedDebugAndroidTest \
    connectedAndroidDeviceTest \
    -Pmaplibre.android.abis="$abi"
}

echo "Running Android device tests for API $api_level, packaging JNI ABI $abi."

set +e
run_gradle 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
set -e

if ((status == 0)); then
  exit 0
fi

if ! "$script_dir/android-install-hang" "$log"; then
  exit "$status"
fi

echo "Android session install hung; rebooting the emulator and retrying once."
if [[ -z "${ANDROID_DEVICE_TEST_SKIP_REBOOT:-}" ]]; then
  "$script_dir/stop-android-emulator"
  "$script_dir/boot-android-emulator" "$api_level"
fi

set +e
{
  printf '\n===== retry after session-install hang =====\n'
  run_gradle
} 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
set -e
exit "$status"
