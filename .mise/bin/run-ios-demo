#!/usr/bin/env bash
# Build the demo app, install it, and launch it. Runs on an iPhone simulator by
# default, or on a connected iPhone with --device. Diagnostics go to stderr.
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "iOS builds run on macOS only." >&2
  exit 2
fi

# mise passes a usage flag as an environment variable; the argument is for
# running this script directly.
target="simulator"
if [[ "${1:-}" == "--device" || "${usage_device:-}" == "true" ]]; then
  target="device"
fi

repository_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
project="$repository_root/demo-app/ios/iosApp.xcodeproj"
derived_data="$repository_root/demo-app/ios/DerivedData"

# The app name and bundle identifier come from the built bundle rather than from
# Config.xcconfig, which composes the identifier out of two settings.
app_bundle() {
  find "$derived_data/Build/Products/$1" -maxdepth 1 -name '*.app' -print -quit
}

bundle_identifier() {
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Info.plist"
}

if [[ "$target" == "simulator" ]]; then
  udid="$("$repository_root/.mise/bin/boot-ios-simulator")"

  xcodebuild -project "$project" -scheme iosApp -configuration Debug \
    -destination "id=$udid" -derivedDataPath "$derived_data" build

  app="$(app_bundle Debug-iphonesimulator)"
  [[ -n "$app" ]] || {
    echo "No app bundle under $derived_data." >&2
    exit 1
  }

  xcrun simctl install "$udid" "$app"
  xcrun simctl launch "$udid" "$(bundle_identifier "$app")"
  open -a Simulator
  exit 0
fi

# A device that is charging, locked, or not yet trusted reports "unavailable",
# so match the ready states exactly rather than by substring.
udid="$(
  xcrun devicectl list devices 2>/dev/null |
    awk '{
      ready = 0
      for (i = 1; i <= NF; i++) if ($i == "connected" || $i == "available") ready = 1
      if (!ready) next
      for (i = 1; i <= NF; i++) if ($i ~ /^[0-9A-F-]{36}$/) { print $i; exit }
    }'
)"
if [[ -z "$udid" ]]; then
  echo "No connected iPhone is ready. Unlock it and trust this Mac, then check" >&2
  echo "that \`xcrun devicectl list devices\` reports it as connected." >&2
  exit 1
fi

# The project carries a DEVELOPMENT_TEAM, so a device build signs without any
# further setup. TEAM_ID in Config.xcconfig only suffixes the bundle identifier,
# which keeps two developers from installing over each other.
# Build for a generic device rather than for "id=$udid": xcodebuild identifies a
# device by its ECID, devicectl by a CoreDevice UUID, and the two do not match.
xcodebuild -project "$project" -scheme iosApp -configuration Debug \
  -destination "generic/platform=iOS" -derivedDataPath "$derived_data" \
  -allowProvisioningUpdates build

app="$(app_bundle Debug-iphoneos)"
[[ -n "$app" ]] || {
  echo "No app bundle under $derived_data." >&2
  exit 1
}

xcrun devicectl device install app --device "$udid" "$app"
xcrun devicectl device process launch --device "$udid" "$(bundle_identifier "$app")"
