#!/usr/bin/env bash
# Build the demo app, install it, and launch it. Runs on an iPhone simulator by
# default, or on a connected iPhone with --device. Prompts when several
# destinations are ready. Diagnostics go to stderr.
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "iOS builds run on macOS only." >&2
  exit 2
fi

# mise passes usage values as environment variables; the arguments are for
# running this script outside of mise.
target="simulator"
requested=""
for arg in "$@"; do
  if [[ "$arg" == "--device" ]]; then
    target="device"
  else
    requested="$arg"
  fi
done
if [[ "${usage_device:-}" == "true" ]]; then
  target="device"
fi
if [[ -z "$requested" && -n "${usage_udid:-}" ]]; then
  requested="$usage_udid"
fi

repository_root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
project="$repository_root/demo-app/ios/iosApp.xcodeproj"
derived_data="$repository_root/demo-app/ios/DerivedData"
pick_from_list="$repository_root/.mise/bin/pick-from-list"

# Read from the built bundle rather than from Config.xcconfig, which composes the
# identifier out of two settings.
app_bundle() {
  find "$derived_data/Build/Products/$1" -maxdepth 1 -name '*.app' -print -quit
}

bundle_identifier() {
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Info.plist"
}

# A device that is charging, locked, or not yet trusted reports "unavailable", so
# match the ready states exactly rather than by substring.
list_ready_ios_devices() {
  # --columns does not control order; find the CoreDevice UUID in the row.
  xcrun devicectl list devices --hide-default-columns --hide-headers \
    --columns Identifier Name State 2>/dev/null |
    awk '
      {
        id = ""
        id_i = 0
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^[0-9A-F-]{36}$/) { id = $i; id_i = i; break }
        }
        if (!id) next
        ready = 0
        for (i = id_i + 1; i <= NF; i++) {
          if ($i == "connected" || $i == "available") ready = 1
        }
        if (!ready) next
        name = ""
        if (id_i > 1) {
          name = $1
          for (i = 2; i < id_i; i++) name = name " " $i
        }
        if (name == "") name = id
        printf "%s\t%s\n", id, name
      }
    '
}

list_booted_iphone_simulators() {
  xcrun simctl list devices available iOS |
    awk -F '[()]' '
      /^-- / {
        runtime = $0
        sub(/^-- /, "", runtime)
        sub(/ --$/, "", runtime)
        next
      }
      / iPhone / && /Booted/ {
        name = $1
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
        printf "%s\t%s (%s)\n", $2, name, runtime
      }
    '
}

pick_id() {
  local kind=$1
  local rows=$2
  "$pick_from_list" "$kind" "$requested" 3<<<"$rows"
}

ensure_simulator_booted() {
  local udid=$1
  local state
  state="$(
    xcrun simctl list devices |
      awk -F '[()]' -v id="$udid" '$0 ~ id { print $4; exit }'
  )"
  if [[ "$state" != "Booted" ]]; then
    echo "Booting iOS simulator $udid." >&2
    xcrun simctl boot "$udid"
  fi
  xcrun simctl bootstatus "$udid" -b >&2
}

if [[ "$target" == "simulator" ]]; then
  if [[ -n "$requested" ]]; then
    udid="$requested"
  else
    booted="$(list_booted_iphone_simulators)"
    if [[ -n "$booted" ]]; then
      udid="$(pick_id "iOS simulator" "$booted")"
    else
      udid="$("$repository_root/.mise/bin/boot-ios-simulator")"
    fi
  fi
  ensure_simulator_booted "$udid"

  xcodebuild -project "$project" -scheme iosApp -configuration Debug \
    -destination "id=$udid" -derivedDataPath "$derived_data" build

  app="$(app_bundle Debug-iphonesimulator)"
  [[ -n "$app" ]] || {
    echo "No app bundle under $derived_data." >&2
    exit 1
  }

  xcrun simctl install "$udid" "$app"
  xcrun simctl launch "$udid" "$(bundle_identifier "$app")"
  open -a Simulator
  exit 0
fi

devices="$(list_ready_ios_devices)"
if [[ -z "$devices" ]]; then
  echo "No connected iPhone is ready. Unlock it and trust this Mac, then check" >&2
  echo "that \`xcrun devicectl list devices\` reports it as connected." >&2
  exit 1
fi
udid="$(pick_id "iOS device" "$devices")"

# Signing needs no setup here: the project carries a DEVELOPMENT_TEAM.
# Build for a generic device rather than for "id=$udid": xcodebuild identifies a
# device by its ECID, devicectl by a CoreDevice UUID, and the two do not match.
xcodebuild -project "$project" -scheme iosApp -configuration Debug \
  -destination "generic/platform=iOS" -derivedDataPath "$derived_data" \
  -allowProvisioningUpdates build

app="$(app_bundle Debug-iphoneos)"
[[ -n "$app" ]] || {
  echo "No app bundle under $derived_data." >&2
  exit 1
}

xcrun devicectl device install app --device "$udid" "$app"
xcrun devicectl device process launch --device "$udid" "$(bundle_identifier "$app")"
