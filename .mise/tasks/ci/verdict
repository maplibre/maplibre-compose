#!/usr/bin/env bash
# [MISE] description="Decide a CI tier's required check from its run."
set -euo pipefail

# PLAN_RESULT, SELECTED, RESTATE, and RESULT come from the plan job and the
# tier's aggregate result. RESTATE means the planner verified earlier coverage.
if [[ ${PLAN_RESULT:-} != success ]]; then
  echo "The plan job concluded ${PLAN_RESULT:-nothing}, so no verdict is possible." >&2
  exit 1
fi

case ${SELECTED:-} in
  true)
    if [[ ${RESULT:-} != success ]]; then
      echo "The tier's jobs concluded ${RESULT:-nothing}." >&2
      exit 1
    fi
    echo "Every job in the tier succeeded."
    exit 0
    ;;
  false) ;;
  *)
    echo "The plan did not say whether the tier was selected." >&2
    exit 1
    ;;
esac

if [[ ${RESULT:-} != skipped ]]; then
  echo "Nothing was selected, yet the tier's jobs concluded ${RESULT:-nothing}." >&2
  exit 1
fi
if [[ ${RESTATE:-} != true ]]; then
  echo "The tier is not required for this pull request."
  exit 0
fi

# The planner verified successful coverage for every platform job on this head.
echo "Every job in the tier already succeeded on this commit."
