#!/usr/bin/env bash
# [MISE] description="Decide a CI tier's required check from its run."
set -euo pipefail

# PLAN_RESULT, SELECTED, RESTATE, and RESULT come from the plan job and the
# tier's aggregate result. CHECK_NAME and HEAD_SHA locate an earlier verdict on
# the same commit when this event changed nothing the tier requires.
if [[ ${PLAN_RESULT:-} != success ]]; then
  echo "The plan job concluded ${PLAN_RESULT:-nothing}, so no verdict is possible." >&2
  exit 1
fi

case ${SELECTED:-} in
  true)
    if [[ ${RESULT:-} != success ]]; then
      echo "The tier's jobs concluded ${RESULT:-nothing}." >&2
      exit 1
    fi
    echo "Every job in the tier succeeded."
    exit 0
    ;;
  false) ;;
  *)
    echo "The plan did not say whether the tier was selected." >&2
    exit 1
    ;;
esac

if [[ ${RESULT:-} != skipped ]]; then
  echo "Nothing was selected, yet the tier's jobs concluded ${RESULT:-nothing}." >&2
  exit 1
fi
if [[ ${RESTATE:-} != true ]]; then
  echo "The tier is not required for this pull request."
  exit 0
fi

# The event did not change what the tier requires, so the latest verdict for
# this check on the commit stands. A sibling run still in progress usually
# finishes first because the callers queue behind each other; poll otherwise.
while true; do
  verdict="$(
    gh api --method GET \
      "repos/${GITHUB_REPOSITORY}/commits/${HEAD_SHA}/check-runs" \
      -f check_name="${CHECK_NAME}" -f per_page=100 \
      --jq '
        [.check_runs[]
          | select(.details_url | test("/runs/'"${GITHUB_RUN_ID}"'/") | not)]
        | sort_by(.started_at) | last // empty
        | "\(.status) \(.conclusion // "") \(.details_url)"
      '
  )"
  if [[ -z ${verdict} ]]; then
    echo "No earlier ${CHECK_NAME} verdict exists for ${HEAD_SHA}." >&2
    echo "Re-run this workflow to evaluate the tier." >&2
    exit 1
  fi
  read -r status conclusion url <<<"${verdict}"
  if [[ ${status} == completed ]]; then
    break
  fi
  echo "Waiting for ${url} (${status})."
  sleep "${POLL_SECONDS:-30}"
done
echo "Restating ${conclusion} from ${url}." | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"
[[ ${conclusion} == success ]]
