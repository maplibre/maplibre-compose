#!/usr/bin/env python3
# [MISE] description="Verify GitHub Actions pins match the pins catalog."
# [MISE] shell="python"

import pathlib
import sys


ROOT = pathlib.Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT))

from ci.action_pins import CATALOG, check_pins  # noqa: E402


def main() -> int:
    problems = check_pins(ROOT)
    if not problems:
        return 0
    for problem in problems:
        print(f"error: {problem}", file=sys.stderr)
    print(
        f"\nRun `mise run ci:fix-action-pins` to copy catalog pins onto consumers. "
        f"Unpinned uses and unused catalog entries still require an edit of "
        f"{CATALOG.as_posix()}.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
