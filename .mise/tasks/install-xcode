#!/usr/bin/env bash
# [MISE] description="Install and select the Xcode version this repository pins."
# [MISE] shell="bash"

# Keep the multi-gigabyte Xcode download optional for non-Apple development.

set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "Xcode installs on macOS only; nothing to do on $(uname -s)." >&2
  exit 0
fi

if ! command -v xcodes >/dev/null 2>&1; then
  echo "error: xcodes is not on PATH" >&2
  echo "Install it with: mise install xcodes" >&2
  exit 1
fi

# `xcodes install` with no argument reads .xcode-version.
xcodes install
xcodes select
