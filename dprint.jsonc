// dprint owns formatting for every language here. Prefer a plugin; exec a
// mise-installed formatter only where no plugin exists.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/build",
    "third_party",
    "**/.gradle",
    "**/.kotlin",
    "**/node_modules",
    "**/dist",
    "**/.astro",
    "docs/public/api",
    "docs/public/metrics-data",
    "docs/src/generated",
    "pnpm-lock.yaml",
    // mise hashes these graphs; formatting them would fail install --locked.
    ".mise/locks/**",
    "kotlin-js-store",
    "**/*.api",
    // Vendored: third-party sources committed as-is.
    "demo-app/common/src/commonMain/composeResources/files/**",
    "gradlew",
    "gradlew.bat",
    // Xcode rewrites these in its own style, so formatting them fights it.
    "demo-app/ios/**/*.xcassets/**",
  ],
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "ruff": { "indentWidth": 4, "lineLength": 88 },
  // Google style's width is 100. The plugin would otherwise inherit the global 80.
  "ktfmt": { "style": "google", "lineWidth": 100 },
  "exec": {
    "commands": [
      {
        "command": "bash .mise/bin/dprint-swiftformat stdin --stdin-path {{file_path}} --indent {{indent_width}} --max-width {{line_width}} --quiet",
        "exts": ["swift"],
      },
      {
        "command": "pnpm --dir docs exec mdxlint --rc-path .mdxlintrc.json --file-path {{file_path}}",
        "exts": ["mdx"],
        "cacheKeyFiles": ["pnpm-lock.yaml"],
      },
    ],
  },
  // Digests are required on a bump; dprint reports the one it got.
  "plugins": [
    "https://plugins.dprint.dev/exec-0.8.0.json@1f2dfbf5dec6d2e590b2c8b0ba6dbfaf80d0320fa9bd4c3f4f29efb99cd2bd6f",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
    "https://plugins.dprint.dev/ruff-0.11.2.wasm@451da30c12783e8cd562e1341c8591a72cacaefafc184ded1e170c0707234f3b",
    "https://plugins.dprint.dev/oxc-0.47.0.wasm@531f729b3ebf18203a07b9c2da869eef5003130ac6a8936c2eca28cf6ee8b20b",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.6.wasm@93dd0c870b60431ceea59f055792fee4a353868223c813d3a44414b31d1df602",
  ],
}
