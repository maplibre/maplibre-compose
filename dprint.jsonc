// dprint owns formatting for every language here. Prefer a plugin; exec a
// mise-installed formatter only where no plugin exists.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/build",
    "third_party",
    "**/.gradle",
    "**/.kotlin",
    "**/node_modules",
    "**/dist",
    "**/.astro",
    "docs/public/api",
    "docs/public/metrics-data",
    "docs/src/generated",
    "pnpm-lock.yaml",
    // mise hashes these graphs; formatting them would fail install --locked.
    ".mise/locks/**",
    "kotlin-js-store",
    "**/*.api",
    // Vendored: third-party sources committed as-is.
    "demo-app/common/src/commonMain/composeResources/files/**",
    "gradlew",
    "gradlew.bat",
    // Xcode rewrites these in its own style, so formatting them fights it.
    "demo-app/ios/**/*.xcassets/**",
  ],
  "json": { "preferSingleLine": true },
  "markdown": { "textWrap": "always" },
  "ruff": { "indentWidth": 4, "lineLength": 88 },
  "exec": {
    "commands": [
      {
        "command": "bash .mise/bin/dprint-ktfmt --google-style - --stdin-name={{file_path}}",
        "exts": ["kt", "kts"],
      },
      {
        "command": "bash .mise/bin/dprint-swiftformat stdin --stdin-path {{file_path}} --indent {{indent_width}} --max-width {{line_width}} --quiet",
        "exts": ["swift"],
      },
      {
        "command": "bash .mise/bin/dprint-mdxlint {{file_path}}",
        "exts": ["mdx"],
        "cacheKeyFiles": ["pnpm-lock.yaml"],
      },
    ],
  },
  // Digests are required on a bump; dprint reports the one it got.
  "plugins": [
    "https://plugins.dprint.dev/exec-0.8.0.json@1f2dfbf5dec6d2e590b2c8b0ba6dbfaf80d0320fa9bd4c3f4f29efb99cd2bd6f",
    "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
    "https://plugins.dprint.dev/ruff-0.11.1.wasm@aeacfccd161ad431a9ad468cae36c01d3abd9d04a4c3c56e0cca07ec9daed703",
    "https://plugins.dprint.dev/markdown-0.26.0.wasm@5cebd0459bf1aa13fb027331720158d03e2a897b1d9f7b3bf93cac661ca4ddbd",
    "https://plugins.dprint.dev/toml-0.9.0.wasm@776e088ed4255a51a80e3640e5fd20b15661147e86df3e99611aaa37e9c59852",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.6.wasm@93dd0c870b60431ceea59f055792fee4a353868223c813d3a44414b31d1df602",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm@1c1b31f972ef5aae052f97b6723aaf962e0175c5bbe4ba877e092512af354113",
  ],
}
